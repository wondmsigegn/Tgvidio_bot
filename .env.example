# ---------- Required ----------
# Token from @BotFather
BOT_TOKEN=8971722528:AAECkek9k1yDx-IP9TeKVdJq_Il8_8Q8NDc
# Comma-separated Telegram user IDs of admins (get yours by sending /id to @userinfobot)
ADMIN_IDS=123456789

# ---------- Up to 2 GB uploads (required by docker-compose.yml) ----------
# Create an app at https://my.telegram.org -> "API development tools"
TELEGRAM_API_ID=31920634
TELEGRAM_API_HASH=3cd4e948171daa9668ae1a4d018ddb6e
# docker-compose sets BOT_API_URL and MAX_UPLOAD_MB=2000 for you.
# Without Docker, run your own local Bot API server and set:
# BOT_API_URL=http://127.0.0.1:8081
# MAX_UPLOAD_MB=2000
# (leave both unset to use Telegram's cloud API with its 50 MB cap)

# ---------- Limits ----------
# Highest quality offered (the bot supports up to 1080)
MAX_HEIGHT=1080
# Refuse videos longer than this many minutes (protects your VPS disk and CPU)
MAX_DURATION_MIN=60
# Seconds (defaults grow automatically when the local Bot API server is used)
INFO_TIMEOUT=60
# DOWNLOAD_TIMEOUT=3600
# UPLOAD_TIMEOUT=7200
# Simultaneous downloads across all users (each big file needs free disk space)
MAX_CONCURRENT_DOWNLOADS=5
# Minimum seconds between messages from one user
USER_COOLDOWN=1.0
# Successful downloads per user per 24h (0 = unlimited, admins are exempt)
DAILY_LIMIT=1000

# ---------- Access to login-only content (optional) ----------
# Operator cookies (Netscape cookies.txt). Used for ADMINS only unless PUBLIC_COOKIES=true.
# WARNING: PUBLIC_COOKIES=true lets every user download through YOUR logged-in account.
# COOKIES_FILE=/app/data/cookies.txt
# PUBLIC_COOKIES=false

# ---------- Network (optional) ----------
# Proxy if platforms block your VPS IP, e.g. http://user:pass@host:port
# PROXY_URL=
# Extra allowed domains (comma-separated) for other yt-dlp supported sites
# EXTRA_DOMAINS=

# ---------- Misc ----------
LOG_LEVEL=INFO
# Docker only: upgrade yt-dlp at container start (sites change often) - 1/0
AUTO_UPDATE_YTDLP=1
